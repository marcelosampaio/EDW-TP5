@page
@model EDW_TP5.Pages.Eventos.IndexModel

@{
    ViewData["Title"] = "Eventos";
}

<h1>Eventos</h1>

@if (Model.Eventos.Count == 0)
{
    <p>Nenhum evento cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Nome</th>
            <th>Data e Hora de Início</th>
            <th>Data e Hora de Término</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var evento in Model.Eventos)
        {
            <tr>
                <td>@evento.Nome</td>
                <td>@evento.DataHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@evento.DataHoraFim.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}